{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "installCommand": "npm install",
  "buildCommand": "node scripts/build-vercel-static.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{infra/database/**,apps/api/src/store.mjs}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__vf_path=:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
