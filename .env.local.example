# vFirm Stage 2 local PostgreSQL
# Copy this file to .env.local for local development if you need DATABASE_URL.

VFIRM_DB_HOST=127.0.0.1
VFIRM_DB_PORT=5439
VFIRM_DB_NAME=vfirm
VFIRM_DB_USER=vfirm
VFIRM_DB_PASSWORD=vfirm_dev_password
VFIRM_POSTGRES_CONTAINER=vfirm-postgres
DATABASE_URL=postgresql://vfirm:vfirm_dev_password@127.0.0.1:5439/vfirm

# Stage 11 staging/pilot configuration
VFIRM_AUTH_PROVIDER=staging-header
VFIRM_ALLOWED_ORIGINS=http://127.0.0.1:3090
VFIRM_BACKUP_POLICY=pilot-daily
VFIRM_RELEASE_CHANNEL=local-pilot


# Stage 12 provider-neutral auth adapter settings
VFIRM_AUTH_MODE=staging
VFIRM_AUTH_ISSUER=
VFIRM_AUTH_AUDIENCE=
VFIRM_AUTH_JWKS_URL=


# Stage 13 staging deployment and data protection
VFIRM_STAGING_DOMAIN=http://127.0.0.1:3090
VFIRM_DATA_CLASSIFICATION_DEFAULT=CONFIDENTIAL
VFIRM_EXPORT_POLICY=tenant-scoped-json-with-provenance
VFIRM_RESTORE_TEST_STATUS=required-before-external-pilot

